generator client {
  provider = "prisma-client-js"
}

datasource bancoDados {
  provider = "postgresql"
  url      = env("URL_BANCO_DADOS")
}

model Cliente {
  identificador   String         @id @default(uuid())
  nome            String
  cpfCnpj         String         @unique @map("cpf_cnpj")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  veiculos        Veiculo[]
  ordensServico   OrdemServico[]

  @@map("clientes")
}

model Veiculo {
  identificador   String         @id @default(uuid())
  clienteId       String         @map("cliente_id")
  placa           String         @unique
  marca           String
  modelo          String
  ano             Int
  criadoEm        DateTime       @default(now()) @map("criado_em")
  cliente         Cliente        @relation(fields: [clienteId], references: [identificador])
  ordensServico   OrdemServico[]

  @@index([clienteId])
  @@map("veiculos")
}

enum StatusOrdemServico {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
}

model OrdemServico {
  identificador String          @id @default(uuid())
  clienteId   String          @map("cliente_id")
  veiculoId   String          @map("veiculo_id")
  descricao   String
  status      StatusOrdemServico @default(RECEBIDA)
  criadoEm    DateTime        @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")
  cliente     Cliente         @relation(fields: [clienteId], references: [identificador])
  veiculo     Veiculo         @relation(fields: [veiculoId], references: [identificador])

  @@index([clienteId])
  @@index([veiculoId])
  @@map("ordens_servico")
}

model Servico {
  identificador   String   @id @default(uuid())
  nome            String   @unique
  descricao       String?
  precoEmCentavos Int      @map("preco_em_centavos")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  @@map("servicos")
}

model PecaInsumo {
  identificador            String   @id @default(uuid())
  codigo                   String   @unique
  nome                     String
  descricao                String?
  precoUnitarioEmCentavos  Int      @map("preco_unitario_em_centavos")
  quantidadeEstoque        Int      @default(0) @map("quantidade_estoque")
  criadoEm                 DateTime @default(now()) @map("criado_em")
  atualizadoEm             DateTime @updatedAt @map("atualizado_em")

  @@map("pecas_insumos")
}
