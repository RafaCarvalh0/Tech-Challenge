generator client {
  provider = "prisma-client-js"
}

datasource bancoDados {
  provider = "postgresql"
  url      = env("URL_BANCO_DADOS")
}

model Cliente {
  identificador   String         @id @default(uuid())
  nome            String
  cpfCnpj         String         @unique @map("cpf_cnpj")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  veiculos        Veiculo[]
  ordensServico   OrdemServico[]

  @@map("clientes")
}

model Veiculo {
  identificador   String         @id @default(uuid())
  clienteId       String         @map("cliente_id")
  placa           String         @unique
  marca           String
  modelo          String
  ano             Int
  criadoEm        DateTime       @default(now()) @map("criado_em")
  cliente         Cliente        @relation(fields: [clienteId], references: [identificador])
  ordensServico   OrdemServico[]

  @@index([clienteId])
  @@map("veiculos")
}

enum StatusOrdemServico {
  RECEBIDA
  EM_DIAGNOSTICO
  AGUARDANDO_APROVACAO
  EM_EXECUCAO
  FINALIZADA
  ENTREGUE
}

enum SituacaoOrcamento {
  PENDENTE
  APROVADO
  REJEITADO
}

model OrdemServico {
  identificador          String                   @id @default(uuid())
  clienteId              String                   @map("cliente_id")
  veiculoId              String                   @map("veiculo_id")
  codigoAcompanhamento   String                   @unique @map("codigo_acompanhamento")
  descricao              String
  status                 StatusOrdemServico       @default(RECEBIDA)
  criadoEm               DateTime                 @default(now()) @map("criado_em")
  atualizadoEm           DateTime                 @updatedAt @map("atualizado_em")
  cliente                Cliente                  @relation(fields: [clienteId], references: [identificador])
  veiculo                Veiculo                  @relation(fields: [veiculoId], references: [identificador])
  itensServico           ItemServicoOrdem[]
  itensPecaInsumo        ItemPecaInsumoOrdem[]
  orcamento              Orcamento?

  @@index([clienteId])
  @@index([veiculoId])
  @@map("ordens_servico")
}

model Servico {
  identificador   String   @id @default(uuid())
  nome            String   @unique
  descricao       String?
  precoEmCentavos Int      @map("preco_em_centavos")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")
  itensOrdem      ItemServicoOrdem[]

  @@map("servicos")
}

model PecaInsumo {
  identificador            String   @id @default(uuid())
  codigo                   String   @unique
  nome                     String
  descricao                String?
  precoUnitarioEmCentavos  Int      @map("preco_unitario_em_centavos")
  quantidadeEstoque        Int      @default(0) @map("quantidade_estoque")
  criadoEm                 DateTime @default(now()) @map("criado_em")
  atualizadoEm             DateTime @updatedAt @map("atualizado_em")
  itensOrdem               ItemPecaInsumoOrdem[]

  @@map("pecas_insumos")
}

model ItemServicoOrdem {
  identificador           String       @id @default(uuid())
  ordemServicoId          String       @map("ordem_servico_id")
  servicoId               String       @map("servico_id")
  nome                    String
  precoUnitarioEmCentavos Int          @map("preco_unitario_em_centavos")
  quantidade              Int
  ordemServico            OrdemServico @relation(fields: [ordemServicoId], references: [identificador], onDelete: Cascade)
  servico                 Servico      @relation(fields: [servicoId], references: [identificador])

  @@unique([ordemServicoId, servicoId])
  @@index([servicoId])
  @@map("itens_servicos_ordem")
}

model ItemPecaInsumoOrdem {
  identificador           String       @id @default(uuid())
  ordemServicoId          String       @map("ordem_servico_id")
  pecaInsumoId            String       @map("peca_insumo_id")
  codigo                  String
  nome                    String
  precoUnitarioEmCentavos Int          @map("preco_unitario_em_centavos")
  quantidade              Int
  ordemServico            OrdemServico @relation(fields: [ordemServicoId], references: [identificador], onDelete: Cascade)
  pecaInsumo              PecaInsumo   @relation(fields: [pecaInsumoId], references: [identificador])

  @@unique([ordemServicoId, pecaInsumoId])
  @@index([pecaInsumoId])
  @@map("itens_pecas_insumos_ordem")
}

model Orcamento {
  identificador                    String            @id @default(uuid())
  ordemServicoId                   String            @unique @map("ordem_servico_id")
  subtotalServicosEmCentavos       Int               @map("subtotal_servicos_em_centavos")
  subtotalPecasInsumosEmCentavos   Int               @map("subtotal_pecas_insumos_em_centavos")
  totalEmCentavos                  Int               @map("total_em_centavos")
  situacao                         SituacaoOrcamento  @default(PENDENTE)
  geradoEm                         DateTime           @default(now()) @map("gerado_em")
  atualizadoEm                     DateTime           @updatedAt @map("atualizado_em")
  decididoEm                       DateTime?          @map("decidido_em")
  ordemServico                     OrdemServico       @relation(fields: [ordemServicoId], references: [identificador], onDelete: Cascade)

  @@map("orcamentos")
}
